{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Palace",
  "version": "0.44.1",
  "identifier": "com.timmcleod.palace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Palace",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Run your agent, review its work, ship it",
    "longDescription": "Your agent writes the code. Palace shows you what changed. You decide what gets shipped.",
    "publisher": "Tim McLeod",
    "copyright": "Copyright © 2026 Tim McLeod",
    "license": "MIT",
    "homepage": "https://github.com/timmcleod/palace",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "git"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxRDQwNTZEQkYyNkRCQTYKUldTbTJ5YS9iUVhVc2E0RlhRcEVqNjdZbEhCalpCRlROa0tweFZRajN2WmpCbmw1RDZSY0JoRWsK",
      "endpoints": [
        "https://github.com/timmcleod/palace/releases/latest/download/latest.json"
      ]
    }
  }
}
